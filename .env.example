PORT=5001
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/vedhshala_db
SITE_URL=http://localhost:3000

# Backend Auth (use long random strings)
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRE=7d
COOKIE_SECRET=
TOTP_APP_NAME=VedhshalaAdmin
ALLOWED_ORIGIN=http://localhost:3003

# Redis (optional — the server runs without it)
REDIS_URL=redis://localhost:6379

# Email Configuration (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Vedhshala
CONTACT_ADMIN_EMAIL=

# WhatsApp (AiSensy / Opus)
AISENSY_API_KEY=
AISENSY_CAMPAIGN_OTP=
AISENSY_CAMPAIGN_CHAT_USER=
AISENSY_CAMPAIGN_CHAT_ADMIN=
OPUS_API_KEY=
ADMIN_WHATSAPP_NUMBER=

# Cloudinary (optional — uploads fall back to public/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI
OPENAI_API_KEY=
GEMINI_API_KEY=
# Browser origins allowed to call /api/chat (comma-separated, empty = any)
ALLOWED_ORIGINS=

# SEO & Google
PAGESPEED_API_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3003

# Website cache refresh after admin saves (must match frontend REVALIDATE_SECRET)
REVALIDATE_SECRET=
